---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import { siteContact, SOCIALS } from '../lib/site';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  // 'glass' — translucent/blurred header, floats over a full-bleed hero;
  // switches to 'solid' once the hero scrolls under it (see the script
  // near the footer). Only the homepage hero calls for this: every other
  // page's content starts below the header, not behind it, so 'solid' —
  // the plain opaque bar — is the default and every other page gets it by
  // omitting the prop, not by passing it explicitly.
  navMode?: 'glass' | 'solid';
}

const {
  title,
  description = 'Original paintings and fine art by Rupjyoti Baruah — T.Art by RJ.',
  ogImage,
  navMode = 'solid',
} = Astro.props;

const fontFiles = [
  'CormorantGaramond-Light',
  'CormorantGaramond-LightItalic',
  'CormorantGaramond-Regular',
  'CormorantGaramond-Italic',
  'Jost-Light',
  'Jost-Regular',
  'Jost-Medium',
];

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Collections', href: '/collections' },
  { label: 'Works', href: '/works' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

// Inner markup for each .footer-social glyph, keyed by SocialLink['icon'].
// Adding a network is one entry in SOCIALS (src/lib/site.ts) plus one entry
// here — the <svg> wrapper, aria-label and link markup below stay untouched.
const socialIcons: Record<string, string> = {
  instagram: `
    <rect x="3" y="3" width="18" height="18" rx="5.2" fill="none" stroke="currentColor" stroke-width="1.7" />
    <circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.7" />
    <circle cx="17.1" cy="6.9" r="1.15" fill="currentColor" />
  `,
  behance: `
    <path d="M3.4 6.6h4.9a2.6 2.6 0 0 1 0 5.2H3.4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
    <path d="M3.4 11.8h5.4a2.9 2.9 0 0 1 0 5.8H3.4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
    <path d="M14.6 7.4h6.1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
    <circle cx="17.65" cy="14.3" r="3.3" fill="none" stroke="currentColor" stroke-width="1.7" />
    <path d="M14.5 13.8h6.3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
  `,
};

// Brand lockup, dropped into src/assets/ as `tart-logo.<ext>`. The footer is
// its only remaining consumer — the top nav renders the wordmark as type.
// Globbed rather than imported directly so a missing file falls back to that
// same wordmark instead of failing the build; Astro optimises it on build.
const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/tart-logo.{png,jpg,jpeg,webp}',
  { eager: true }
);
const logo = Object.values(logoFiles)[0]?.default;

// Computed at build time, not hardcoded. The literal this replaced read 2025
// and had already gone stale. Static build, so this is the year of the last
// deploy — which for a copyright notice is the correct semantics anyway, and
// the Sanity webhook rebuilds often enough that it cannot drift far.
const copyrightYear = new Date().getFullYear();
---

<html lang="en">
  <head>
    <script is:inline>
      (function () {
        var saved = null;
        // Throws in storage-blocked contexts (Safari private mode, locked-down
        // corporate browsers). Must not prevent data-theme from being set.
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {
          saved = null;
        }
        var system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', saved || system || 'light');
      })();
    </script>

    <noscript>
      <!-- is:inline — must stay global and unscoped; .reveal elements live in
           page components, not in this layout's style scope. -->
      <style is:inline>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — T.Art by RJ</title>

    {fontFiles.map((file) => (
      <link rel="preload" href={`/fonts/${file}.woff2`} as="font" type="font/woff2" crossorigin />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — T.Art by RJ`} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <slot name="jsonld" />
  </head>
  <body>
    <div class="cursor" id="cursor"></div>
    <div class="cursor-ring" id="cursor-ring"></div>

    <nav id="nav" class:list={[navMode === 'glass' && 'nav-glass']}>
      <!-- Type wordmark, not an image: it needs no request, is sharp at every
           density, recolours itself with the theme, and is real selectable text
           for search engines. The case is set here in the markup, character by
           character — see .nav-logo-text's text-transform. -->
      <!-- No aria-label: the accessible name comes from the visible text of the
           two spans, which is exactly what WCAG 2.5.3 (Label in Name) asks for
           — a speech-input user saying either line matches, and both lines get
           announced. A label here would replace that text wholesale. -->
      <a href="/" class="nav-logo">
        <span class="nav-logo-text">T.ART <span class="nav-logo-accent">by</span> RJ</span>
        <span class="nav-logo-tagline">WHERE TASTE & ART BLENDS</span>
      </a>
      <div class="nav-right">
        <div class="nav-links">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
        <ThemeToggle />
        <button id="menu-toggle" class="hamburger" aria-label="Open menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="mobile-menu">
      <button id="menu-close" class="menu-close" aria-label="Close menu">✕</button>
      {navLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </div>

    <!-- id + tabindex="-1" exist for the footer's "back to top" link. The
         tabindex makes <main> programmatically focusable without putting it in
         the tab order, so the control can move focus to the top of the CONTENT
         rather than leaving it stranded at the bottom of the page — or handing
         it to the fixed nav, which would strand a keyboard user one Tab away
         from re-entering the menu they just left. Not styled on :focus: only
         a:focus-visible / button:focus-visible carry rings (global.css), so
         this never paints an outline around the whole page. -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-tier1">
          <div class="footer-col footer-brand">
            <div class="footer-logo">
              {logo ? (
                /* The alt text carries the full lockup wording, including the
                   tagline baked into the pixels. That matters more than it used
                   to: --footer-logo-h (see the `footer {}` rule below for the
                   current value and full cut history) dropped below the height
                   at which the image's own tagline resolves, so the alt string
                   is now the only place that wording exists in this element.
                   See ARCHITECTURE.md §18. */
                <Image
                  class="footer-logo-img"
                  src={logo}
                  alt="T.ART by RJ — Where Taste & Art Blends"
                  width={320}
                  densities={[1, 2]}
                />
              ) : (
                <span class="footer-logo-text">T.ART by RJ</span>
              )}
            </div>
            <p class="footer-descriptor">
              Murals, paintings and drawings by Rupjyoti Baruah — work made about the
              people, places and living beings that carried a story first.
            </p>
            <p class="footer-place">Dubai, UAE · Assam, India</p>
          </div>

          <nav class="footer-col footer-explore" aria-labelledby="footer-explore-heading">
            <h2 class="footer-heading" id="footer-explore-heading">Explore</h2>
            {/* Driven by the same navLinks array the header renders. The footer
                used to hold a second hardcoded copy of these five items, which
                is a drift risk with no upside — the two lists have never
                intentionally differed. */}
            <ul class="footer-links">
              {navLinks.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </nav>

          <div class="footer-col footer-connect">
            <h2 class="footer-heading">Connect</h2>
            <a class="footer-email" href={`mailto:${siteContact.email}`}>{siteContact.email}</a>
            <p class="footer-availability">
              Commissions, workshops and studio visits — enquiries welcome.
            </p>
            {/* Links, not buttons: they navigate. Each carries its own
                accessible name via aria-label, because the only thing inside is
                a decorative glyph — the SVGs are aria-hidden so a screen reader
                never tries to describe the path data. rel="noopener noreferrer"
                on both: target="_blank" without noopener hands the opened tab a
                live window.opener handle back into this origin. */}
            <ul class="footer-social">
              {SOCIALS.map((social) => (
                <li>
                  <a
                    href={social.href}
                    aria-label={`T.Art by RJ on ${social.label}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      focusable="false"
                      set:html={socialIcons[social.icon]}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="footer-tier2">
          <p class="footer-copy">© {copyrightYear} Rupjyoti Baruah</p>
          {/* Room reserved here for Privacy / Terms / Refunds. Not needed while
              the site sets no cookies and collects nothing; required the moment
              Phase 5 ships Stripe/Snipcart and Formspree. See ARCHITECTURE.md §18. */}
          {/* A real anchor, so it works with no JS at all: #main-content is a
              genuine element, and tabindex="-1" there means the native jump also
              moves focus. The script below upgrades it to a smooth scroll and
              suppresses the hash — see the IIFE near the other footer scripts. */}
          <a class="footer-top" id="footer-top" href="#main-content">
            Back to top
            <span class="footer-top-arrow" aria-hidden="true">↑</span>
          </a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var toggle = document.getElementById('menu-toggle');
        var close = document.getElementById('menu-close');
        var menu = document.getElementById('mobile-menu');

        function openMenu() {
          menu.classList.add('open');
          toggle.setAttribute('aria-expanded', 'true');
        }
        function closeMenu() {
          menu.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
        }

        toggle.addEventListener('click', openMenu);
        close.addEventListener('click', closeMenu);
        menu.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', closeMenu);
        });
      })();

      (function () {
        // Back to top. The anchor already works without this — it points at a
        // real element and would jump there natively. What the script buys is
        // two things the bare anchor cannot do:
        //   1. no hash. A native jump leaves #main-content in the address bar
        //      and in history, so Back becomes "scroll down again" rather than
        //      "previous page".
        //   2. reduced-motion-aware smoothing. There is no global
        //      scroll-behavior: smooth in this project (see global.css — the
        //      only motion guard there covers .reveal), so smoothing is opted
        //      into here, per-interaction, and only when the user allows it.
        // Focus still moves, exactly as the native jump would: scrolling alone
        // would leave a keyboard user's focus at the bottom of the page while
        // the viewport sits at the top.
        var link = document.getElementById('footer-top');
        var main = document.getElementById('main-content');
        if (!link || !main) return;

        link.addEventListener('click', function (event) {
          // Let modified clicks (new tab/window) fall through to the browser.
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
          // preventScroll, or the focus call yanks the viewport to <main>'s top
          // instantly and the smooth scroll it is racing never gets to play.
          main.focus({ preventScroll: true });
        });
      })();

      (function () {
        // Glass-to-solid toggle for the homepage hero. Guarded on #nav
        // actually carrying .nav-glass at parse time — every other page
        // never adds that class (navMode defaults to 'solid' in
        // Layout.astro), so this whole block is a no-op there: one property
        // read, one comparison, nothing observed. Same shape as the .reveal
        // observer below rather than a scroll-position pixel threshold, per
        // project convention for anything IntersectionObserver can do
        // instead.
        var nav = document.getElementById('nav');
        var hero = document.getElementById('hero-track');
        if (!nav || !hero || !nav.classList.contains('nav-glass')) return;

        // rootMargin shrinks the observing viewport by the bar's own
        // height, so "intersecting" turns false at the exact moment the
        // hero's bottom edge would otherwise be passing UNDER the bar, not
        // merely leaving the visible viewport — which is the "any
        // subsequent section's headline would pass under the header"
        // condition the task asked for, expressed as geometry instead of a
        // hardcoded pixel number. Read once at load, not kept in sync with
        // resize — --nav-h only changes at the 900px breakpoint, and a
        // hero this tall makes that single-frame slop invisible in
        // practice.
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              nav.classList.toggle('nav-glass', entry.isIntersecting);
            });
          },
          { rootMargin: -nav.offsetHeight + 'px 0px 0px 0px', threshold: 0 }
        );
        observer.observe(hero);
      })();

      (function () {
        var targets = document.querySelectorAll('.reveal');
        if (!targets.length) return;
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        targets.forEach(function (t) {
          observer.observe(t);
        });
      })();

      (function () {
        var mq = window.matchMedia('(hover: hover) and (pointer: fine)');
        if (!mq.matches) return;

        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var cursor = document.getElementById('cursor');
        var ring = document.getElementById('cursor-ring');

        var mouseX = 0, mouseY = 0;
        var ringX = 0, ringY = 0;

        window.addEventListener('mousemove', function (e) {
          mouseX = e.clientX;
          mouseY = e.clientY;
          cursor.style.left = mouseX + 'px';
          cursor.style.top = mouseY + 'px';
          if (reduceMotion) {
            ring.style.left = mouseX + 'px';
            ring.style.top = mouseY + 'px';
          }
        });

        function loop() {
          if (!reduceMotion) {
            ringX += (mouseX - ringX) * 0.12;
            ringY += (mouseY - ringY) * 0.12;
            ring.style.left = ringX + 'px';
            ring.style.top = ringY + 'px';
          }
          requestAnimationFrame(loop);
        }
        requestAnimationFrame(loop);

        document.querySelectorAll('a, button').forEach(function (el) {
          el.addEventListener('mouseenter', function () {
            cursor.classList.add('cursor-hover');
            ring.classList.add('cursor-hover');
          });
          el.addEventListener('mouseleave', function () {
            cursor.classList.remove('cursor-hover');
            ring.classList.remove('cursor-hover');
          });
        });
      })();
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
  }

  /* Scoped here, not folded into global.css's a:focus-visible /
     button:focus-visible rule — and that's fine, because #main-content is
     declared directly in THIS component's markup, so Astro's scoped CSS
     attaches its data-astro-cid attribute here and this selector matches. The
     global.css rule had to be unscoped for the opposite reason: it targets
     <a>/<button> elements that live in every OTHER component's markup, which
     a Layout-scoped rule could never reach.
     Without this, focusing <main> (the back-to-top target — see the footer
     script) fell through to the browser's own UA-default outline instead of
     the site's gold ring, the one visible seam where a focus target didn't
     match every other focusable element on the page. */
  #main-content:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 1px;
  }

  @media (hover: hover) and (pointer: fine) {
    body {
      cursor: none;
    }
  }

  .cursor,
  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    border-radius: 50%;
    z-index: 9999;
    transform: translate(-50%, -50%);
  }

  .cursor {
    width: 9px;
    height: 9px;
    background: var(--accent);
    transition: width var(--dur-base) var(--ease-out), height var(--dur-base) var(--ease-out);
  }

  .cursor-ring {
    width: 34px;
    height: 34px;
    border: 1px solid var(--accent);
    opacity: 0.5;
    transition: width var(--dur-base) var(--ease-out), height var(--dur-base) var(--ease-out);
  }

  .cursor.cursor-hover {
    width: 5px;
    height: 5px;
  }

  .cursor-ring.cursor-hover {
    width: 50px;
    height: 50px;
  }

  @media (hover: none) {
    .cursor,
    .cursor-ring {
      display: none;
    }
  }

  /* --logo-h no longer sizes anything visible — the wordmark is 22px of type —
     but it still sets the nav's height, so it stays. Nav height is a budget,
     not a free choice: every other page hardcodes a top offset to clear this
     fixed bar (140px on /works and /collections, 150px /about, 160px /contact,
     120px mobile), and it is published as --nav-h in tokens.css for everything
     that offsets against it. At 64 + 2×18 the bar is 100px. Letting the bar
     collapse to the height of the type would leave every one of those offsets
     over-reserving by 40px, so .nav-logo holds the old height open instead.
     Change --logo-h or this padding and --nav-h must follow.
     The 900px block below drops --logo-h to 44px for an 80px bar; tokens.css
     overrides --nav-h at the same breakpoint to match. */
  /* Flat, opaque header by default — same background token in both themes,
     so it always matches whatever theme is active, pixel-identical to a
     plain opaque bar with no partial transparency anywhere in it. This is
     the ONLY state every page but the homepage ever renders: navMode
     defaults to 'solid', and nothing below this rule applies without the
     .nav-glass class, which only Layout's navMode="glass" branch adds.
     The transition here is dead weight on every solid-only page — nothing
     ever changes for the properties it names — but it's declared once, on
     the base rule, rather than duplicated onto .nav-glass, so the SAME
     values ease in when .nav-glass is added and ease back out when it's
     removed on scroll. See the script near the footer for what drives that
     toggle and why it's a class swap, not a direct style write. */
  #nav {
    --logo-h: 64px;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 52px;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-strong);
    transition: background-color var(--dur-base) ease,
                backdrop-filter var(--dur-base) ease,
                border-color var(--dur-base) ease;
  }

  /* Glass state — homepage hero only. The 85% floor is the load-bearing
     part, not the blur: compositing var(--bg-primary) at 85% UNDER
     backdrop-filter is what keeps the bar's luminance dominated by that
     scrim rather than by whatever painting happens to be scrolled behind
     it at a given moment, so nav-link contrast holds regardless of the
     artwork. The blur adds texture on top of an already-controlled
     background, it isn't what controls contrast — a blurred but fully
     transparent bar would still let a bright sky or dark canvas swing
     contrast wildly depending on scroll position, which is exactly the
     failure a "glass" header usually has.
     color-mix(), not a hand-written rgba(): var(--bg-primary) is already
     themed, so reading it through color-mix gets both themes for free from
     one rule — the same pattern the footer's bleed gradient already uses
     elsewhere in this file. No new dark-theme block, unlike the footer
     texture tokens, because those were calibrated against a photograph
     with no CSS-variable equivalent; this scrim is built from a token that
     already is one.
     border-bottom-color, not the border-bottom shorthand: the 1px width
     stays reserved either way, so toggling this class never shifts layout
     by a pixel — only the color (and so the visibility) of the line
     changes.
     No -webkit-backdrop-filter fallback omission: Safari still needs the
     prefix for this property. */
  #nav.nav-glass {
    background-color: color-mix(in srgb, var(--bg-primary) 85%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom-color: transparent;
  }

  /* A two-line lockup: wordmark over tagline, stacked in a column.
     align-items: flex-start keeps both lines on the same left edge, which is
     the alignment the eye actually reads. The column's width is whichever line
     is wider — that is what .nav-logo-tagline's justify trick depends on, so
     the wordmark has to stay the wider of the two.
     min-height carries the bar: it is the only thing left holding the nav to
     the --logo-h budget now that no image does, and --nav-h depends on it. */
  .nav-logo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: var(--logo-h);
    min-width: 0;
    text-decoration: none;
  }

  .nav-logo-text {
    font-family: var(--font-serif);
    font-size: 26.62px; /* 24.2px +10% */
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--text-primary);
    /* Explicit, not inherited-by-luck. The wordmark's case is mixed on purpose
       — caps through T.ART, lowercase "by" — so it has to come from the markup
       and survive intact. Both .nav-links a and .footer-links a in this same
       stylesheet uppercase their text; nothing in the current ancestor chain
       reaches this, and this rule is what keeps that true if one ever does. */
    text-transform: none;
  }

  .nav-logo-accent {
    font-style: italic;
    color: var(--accent);
  }

  /* The tagline is set to the exact width of the wordmark above it, so the
     lockup reads as one block with two flush edges rather than two loose lines.
     align-self: stretch takes the column's full width, which is the wordmark's;
     text-align-last then justifies what is a single line — the last line is
     also the only line — spreading the four word gaps to close the remainder.
     This only works while the tagline's *natural* width stays under the
     wordmark's: overshoot and the tagline sets the column width instead, the
     justify goes slack and the wordmark stops defining the edge. font-size and
     letter-spacing here are tuned to land just short; they are the two knobs to
     turn if the wordmark is ever resized. */
  .nav-logo-tagline {
    align-self: stretch;
    margin-top: 8px;
    font-family: var(--font-sans);
    font-size: 10.16px; /* 9.24px +10% */
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--text-secondary);
    text-transform: none;
    text-align: justify;
    text-align-last: justify;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    font-size: 15.4px; /* 14px +10% */
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--dur-base) ease;
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 1px;
    background: var(--text-primary);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--bg-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    opacity: 0;
    pointer-events: none;
    /* visibility (not just opacity) — removes the 5 links + close button from
       the tab order while closed. Delayed to the end of the fade so the
       close animation still plays. */
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity var(--dur-slow) var(--ease-out),
                transform var(--dur-slow) var(--ease-out),
                visibility 0s linear var(--dur-slow);
  }

  .mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transform: translateY(0);
    transition: opacity var(--dur-slow) var(--ease-out),
                transform var(--dur-slow) var(--ease-out),
                visibility 0s;
  }

  .mobile-menu a {
    font-family: var(--font-serif);
    font-size: clamp(28px, 6vw, 42px);
    color: var(--text-primary);
    text-decoration: none;
  }

  .menu-close {
    position: absolute;
    top: 22px;
    right: 24px;
    background: none;
    border: none;
    font-size: 20px;
    color: var(--text-primary);
    cursor: pointer;
  }

  @media (max-width: 900px) {
    #nav {
      --logo-h: 44px;
      padding: 18px 24px;
    }

    .nav-links {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }

  /* --footer-logo-h was 180px, chosen so the tagline baked into the lockup
     image resolved: its cap height is ~3.8% of the file, so 180px put it near
     7px, the point it stopped being texture. That floor NO LONGER BINDS —
     see ARCHITECTURE.md §18. Two reasons. First, the image is no longer the
     only carrier of that wording: the nav renders "WHERE TASTE & ART BLENDS"
     as live text, and the brand column sets a real descriptor line under the
     lockup, so the image's internal tagline is decoration and the <Image>
     alt string holds the full wording for anyone who can't see it.
     Second — and this is the load-bearing one — footer height is also the
     texture's crop control. The strip is ~8.6:1 under background-size: cover,
     so a taller footer scales it WIDER and the gold/marble region that lives
     in the right quarter expands left, straight under the Connect column.
     CURRENT VALUE: 72px desktop (44px at the 900px mobile breakpoint below).
     History — this is the ONE place that tracks it, so it doesn't have to be
     kept in sync across multiple comments: 180px → 132px → 96px → 72px,
     across two cutting passes that together took total footer height down
     ~25%+ via every lever available — lockup, prose measure, and every
     vertical margin in the tier. See SESSIONS.md 2026-08-19 for why each cut
     happened. Prefer this lever over --footer-scrim, which tokens.css caps at
     ~0.32 (past that the texture is invisible and the 22KB buys a flat
     colour). This one has no ceiling — but see the plate-wide sweep note in
     ARCHITECTURE.md §18: even with no text sitting on it, the dark
     --footer-muted plate-wide minimum is close enough to 4.5:1 that it should
     not be cut further without re-measuring.
     Never buy contrast by dimming --footer-muted; tokens.css forbids it. */
  /* --bleed is the depth of the dissolve at the top edge. The old treatment
     was a 1px --border hairline, which drew a line the eye reads as "the page
     stopped here". A textured band under a hairline looks pasted on. Fading
     --bg-primary out over 72px instead lets the plaster surface up out of the
     page, which is the whole reason for using a painted texture rather than a
     flat --bg-elevated block. The bleed is padding the content must clear,
     so it is added to padding-top rather than overlapping it. */
  footer {
    --footer-logo-h: 72px;
    --bleed: 72px;
    padding: calc(20px + var(--bleed)) 52px 16px;
    background-color: var(--bg-primary);
    /* Three layers, top to bottom: the bleed, the scrim wash, the texture.
       The scrim is a two-stop gradient of one colour because linear-gradient
       is the only way to lay a flat rgba over a background-image in the same
       property — background-color sits under all image layers, not between
       them. background-size/-position/-repeat below are written as matching
       three-value lists so each layer is addressed explicitly; leaving them
       to the shorthand's cycling behaviour is what makes multi-layer
       backgrounds break the next time someone adds a layer. */
    background-image:
      linear-gradient(
        to bottom,
        var(--bg-primary) 0%,
        color-mix(in srgb, var(--bg-primary) 55%, transparent) 45%,
        transparent 100%
      ),
      linear-gradient(var(--footer-scrim), var(--footer-scrim)),
      var(--footer-texture);
    background-size: 100% var(--bleed), cover, cover;
    /* Right-anchored, not centered. The strip is ~8.6:1; at desktop/tablet
       widths cover crops hard enough that only the texture's right portion
       — where the gold/marble incident sits — is ever visible, and centering
       would show the flat plaster instead. This layer is dropped below 480px
       entirely (see the @media block after this rule's breakpoints) rather
       than kept centered or right-anchored there: the single-column mobile
       footer is tall enough that cover scales the strip to several multiples
       of the viewport width, at which point what renders is a soft gradient
       rather than legible texture either way. */
    background-position: top center, center, right center;
    background-repeat: no-repeat, no-repeat, no-repeat;
  }

  /* The footer element itself keeps carrying the background stack and the
     bleed padding; layout happens one level in, so nothing here can disturb
     the three-layer geometry above. */
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2.4vw, 28px);
  }

  /* Brand is widest — it carries the lockup plus a measure of prose. Explore is
     narrowest: five short uppercase words. minmax(0, …) on every track because
     a long email in column 3 would otherwise blow the grid out past 100% (the
     default `auto` minimum refuses to shrink below max-content). */
  .footer-tier1 {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  /* Column headings. Geometry — 11px / 0.22em / uppercase — is the spec
     .ci-eyebrow and .works-eyebrow already share (CLAUDE.md); no third eyebrow
     value enters the system.
     Colour is NOT inherited from that spec, which uses --text-secondary and is
     calibrated for flat backgrounds. It takes --footer-text (0.94), not
     --footer-muted (0.88): those two rules are orthogonal — the shared eyebrow
     convention governs geometry so a heading reads as the same component
     across pages, while tokens.css governs colour on the one photographic
     surface. Nothing obliges a footer eyebrow to take the muted token merely
     because it is an eyebrow, and 0.94 puts 11px above the contrast the 12px
     copyright already clears (the 4.5:1 bar is size-independent below the
     large-text tier). The hierarchy is carried by the size drop, the tracking
     and the rule beneath — never by alpha, which is the same argument
     tokens.css makes when it says the tiers separate by size.
     font-weight is spelled out because this is an <h2>: the UA default is bold,
     and body is 300. 400 rather than 300 for the reason §18 gives for the 16px
     link size — heavier strokes hold up against pixel-level variance on a
     photograph in a way a contrast ratio does not capture. */
  .footer-heading {
    margin: 0 0 10px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--footer-text);
  }

  /* The texture is decoration with no informational content, and at 22KB it
     is not worth a print job's ink. Content keeps its colours from tokens. */
  @media print {
    footer {
      background-image: none;
      padding-top: 40px;
    }
  }

  .footer-logo {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  /* Fallback only — shown if the lockup file is ever missing from src/assets.
     Same wordmark as the nav, one step down; see .nav-logo-text for why
     text-transform is spelled out rather than left to inheritance. */
  .footer-logo-text {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    /* --footer-text, not --text-primary: this fallback renders on the same
       photographic surface as everything else in the footer, and
       --text-primary is calibrated for flat backgrounds. Same reasoning as
       .footer-heading above. */
    color: var(--footer-text);
    text-transform: none;
  }

  /* Height-driven: the lockup is wide and short, so height is what has to stay
     consistent. Width follows the source aspect ratio, and min-width: 0 on the
     flex parent lets it shrink rather than shove the footer links off-screen at
     awkward widths. */
  .footer-logo-img {
    height: var(--footer-logo-h);
    width: auto;
    max-width: 100%;
    display: block;
  }

  /* The descriptor the lockup's own baked-in tagline no longer carries at
     132px. 16px and --footer-text put it in the same tier as .footer-links a,
     which is where tokens.css's 16px/12px split wants readable prose. */
  /* max-width widened from 34ch to 48ch — a layout change, not a copy edit.
     The sentence is unchanged; a wider measure wraps it to two lines instead
     of three, which is what actually pays for height here (the Brand column
     was the tallest of the three, and this line was why). 48ch, not 44-46:
     at 1440px (~490px column, ~53ch), the current copy needs the full top of
     the authorized 44-48ch range to actually drop to 2 lines — 46ch measured
     3 lines empirically. Verify with getClientRects() rather than eyeballing
     if this copy or the column width ever changes; the line count doesn't
     move linearly with ch the way it looks like it should.
     THE 2-LINE WRAP DOES NOT HOLD ACROSS THE WHOLE DESKTOP RANGE. .footer-tier1
     is `fr`-based (see the grid-template-columns rule above), so the Brand
     column's rendered width — and therefore the line count at a fixed 48ch —
     shrinks continuously as the viewport narrows toward the 900px breakpoint,
     it is not just an 1440px-vs-900px binary. Measured with real
     getClientRects() at several widths between the 900px collapse and 1440px:

       viewport   brand column   descriptor lines   footer height
       901px      291px          4                  386px
       1050px     346px          3                  389px
       1200px     401px          3                  392px
       1300px     438px          3                  392px
       1325px     447px          2                  392px
       1440px     490px          2                  392px

     So the 2-line wrap this comment describes only holds above roughly
     1320px viewport width (~445px column) — below that, down through the
     entire 901-1300px band, it's 3 lines, and right at the 901px edge it's
     4. The height budget itself does NOT break, though: footer height stays
     at or under the 392px target across the whole range regardless of line
     count (the other cuts in this pass compensate), so there is no forced
     follow-up here — but do not describe this as "wraps to 2 lines" without
     qualifying the viewport range, and re-measure with the table method
     above if the grid fractions, gap clamp(), or copy length change. */
  .footer-descriptor {
    margin: 12px 0 0;
    max-width: 48ch;
    font-size: 16px;
    /* 1.6, the tight end of the authorized 1.6–1.7 range — the last lever,
       used once the sizing/spacing cuts alone didn't reach target. Doesn't
       touch contrast: line-height carries no ratio of its own. */
    line-height: 1.6;
    color: var(--footer-text);
  }

  /* 12px + --footer-muted — the same tier as .footer-copy, deliberately: this
     is metadata about the studio, not a claim on the reader's attention. */
  .footer-place {
    margin: 8px 0 0;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--footer-muted);
  }

  /* Declared after the base rule, not folded into the nav's media block above —
     that block sits earlier in the file, and an equal-specificity `footer` rule
     later in source order would override it. */
  @media (max-width: 900px) {
    footer {
      /* 44px — for the crop reason on the base rule's comment (which is the
         one place that tracks --footer-logo-h's full cut history), and
         doubly so here: a single-column footer is the tallest arrangement
         this layout produces, so it's also the one that widens the texture
         most (moot below 480px specifically — see the image-layer-drop rule
         further down — but this breakpoint runs 480–900px too, where the
         texture is still present). Cut in the same height-reduction pass as
         the desktop value; see that rule's comment. */
      --footer-logo-h: 44px;
      /* A shallower bleed: the same 72px reads as a much larger share of a
         wrapped mobile footer, and the dissolve stops being an edge and
         starts being most of the block. */
      --bleed: 48px;
      padding: calc(12px + var(--bleed)) 24px 12px;
    }

    /* One column, same source order, everything on the same left edge. No
       display: none anywhere in the footer and no second copy of any element —
       the grid collapses, nothing is withheld from a narrow screen. */
    .footer-tier1 {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }

  /* Below 480px the single-column footer is tall enough that background-size:
     cover scales the ~8.6:1 strip to several multiples of the viewport width,
     so what actually renders is a soft, largely flat gradient — the sweep at
     390px measured just 4.9%/5.4% of the strip visible (light/dark). The
     image layer is dropped entirely at this width: --bg-primary bleed and
     --footer-scrim stay, so the footer still reads as a warm plate, just
     without paying 22KB for texture too small to resolve as texture. Image
     layer only — the gradient and scrim wash are untouched, and --bleed
     itself is still off-limits (decorative, and not this lever's job). */
  @media (max-width: 479.98px) {
    footer {
      background-image:
        linear-gradient(
          to bottom,
          var(--bg-primary) 0%,
          color-mix(in srgb, var(--bg-primary) 55%, transparent) 45%,
          transparent 100%
        ),
        linear-gradient(var(--footer-scrim), var(--footer-scrim));
      background-size: 100% var(--bleed), cover;
      background-position: top center, center;
      background-repeat: no-repeat, no-repeat;
    }
  }

  /* Vertical, not the old horizontal row: this is a column in a three-column
     tier now, and five uppercase items on one line would set the column's
     min-content width far wider than its share. */
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* --footer-text, not --text-secondary. Identical intent, recalibrated for
     the one surface on the site with a photographic background — see the
     footer block in tokens.css. The nav's copy of this rule keeps
     --text-secondary, because the nav has no texture. */
  /* 16px, not the nav's 14px. Deliberately out of step with .nav-links a,
     for two reasons. The footer block is ~330px tall against the nav's 100,
     so the same type reads as undersized in it. And these sit on a
     photographic surface: heavier strokes hold up against pixel-level
     variance in a way a contrast ratio does not capture — 14px uppercase
     does not reach the WCAG large-text tier (18.66px bold / 24px regular),
     so the 4.5:1 requirement applies either way and the extra weight is
     bought for legibility, not to relax a threshold. */
  /* inline-block + padding-block so each row is a ~27px target rather than the
     19px the type alone would give — WCAG 2.5.8 wants 24×24, and the inline
     exception does not apply to a stacked list like this one. The list gap was
     cut to compensate, so the visual rhythm is unchanged. Size itself is
     untouched: 16px is load-bearing per the note above. */
  .footer-links a {
    display: inline-block;
    padding-block: 4px;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--footer-text);
    text-decoration: none;
  }

  /* The nav's version of this rule recolours the text to --accent. The footer
     cannot: measured locally over the strip, --accent lands at 2.43:1 in
     light and 2.82:1 in dark, both well under AA — and dark is the worse of
     the two precisely because #c9a96e is gold sitting on the gold band, the
     single worst pairing available. Hover is a state a reader occupies while
     reading, so it has to clear the threshold like any other.
     So the text holds --footer-text and the accent moves to the underline,
     where it is decoration rather than text and carries no contrast
     obligation. The affordance also stops depending on colour alone, which
     is what WCAG 1.4.1 asks for and the nav's version does not satisfy. */
  .footer-links a:hover {
    color: var(--footer-text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  /* --footer-muted, not --text-muted: this line sits over the darkest region
     of the strip, where --text-muted measures 3.90:1 and fails AA. See the
     footer block in tokens.css for how both footer text tokens were derived.
     12px, not the original 10px. 10px was already below the floor most
     accessibility guidance puts on body-adjacent text, and it was the worst
     case in the whole footer: the smallest type sitting on the busiest part
     of the strip. Since --footer-muted is now close to --footer-text in
     value, this size gap plus its position is what separates the two tiers —
     see the note in tokens.css before dimming it to restore the old gap. */
  .footer-copy {
    margin: 0;
    font-size: 12px;
    color: var(--footer-muted);
  }

  /* Not uppercased and not tracked, unlike every other link in this footer: an
     email address is a literal string a reader may need to transcribe, and
     letter-spacing on an address makes the dot and the @ harder to place, not
     easier. overflow-wrap so a long address breaks inside the column instead
     of setting a min-content width the grid then has to honour. */
  .footer-email {
    display: inline-block;
    padding-block: 4px;
    font-size: 16px;
    color: var(--footer-text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  /* Same hover contract as .footer-links a, and for the same measured reason:
     the text colour never moves to --accent (2.43:1 light / 2.82:1 dark), the
     accent moves to the underline where it is decoration. */
  .footer-email:hover,
  .footer-top:hover {
    color: var(--footer-text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .footer-availability {
    margin: 6px 0 0;
    max-width: 30ch;
    font-size: 12px;
    line-height: 1.7;
    color: var(--footer-muted);
  }

  .footer-social {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    gap: 12px;
  }

  /* 42px circles — comfortably past WCAG 2.5.8's 24×24, with the gap keeping
     the targets from sharing an edge. The border is derived from --footer-text
     via color-mix rather than reaching for --border-strong, which is calibrated
     against flat backgrounds; deriving keeps it themed from one token, the same
     pattern #nav.nav-glass and the bleed gradient already use. It is a
     container, not the affordance — the glyph inside carries --footer-text at
     full strength, so 1.4.11's 3:1 is met by the icon itself. */
  .footer-social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--footer-text) 28%, transparent);
    color: var(--footer-text);
    transition: border-color var(--dur-base) ease;
  }

  .footer-social a:hover {
    border-color: var(--accent);
  }

  .footer-social svg {
    display: block;
    width: 19px;
    height: 19px;
  }

  /* The rule that divides the tiers. Derived from --footer-text for the same
     reason as the social circles — --border/--border-strong are page tokens. */
  .footer-tier2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
    flex-wrap: wrap;
    padding-top: clamp(10px, 1.4vw, 14px);
    border-top: 1px solid color-mix(in srgb, var(--footer-text) 18%, transparent);
  }

  /* 12px, matching .footer-copy across the bar. --footer-text rather than
     --footer-muted because this one is interactive: a control a reader has to
     find, not a line they read once. */
  .footer-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-block: 6px;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--footer-text);
    text-decoration: none;
  }

  .footer-top-arrow {
    font-size: 14px;
    line-height: 1;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .footer-top:hover .footer-top-arrow {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-top-arrow {
      transition-duration: 1ms;
    }
  }

</style>
