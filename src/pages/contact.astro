---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <section class="contact">
    <p class="label">Get in touch</p>
    <h1 class="contact-title">Contact &amp; Purchase</h1>
    <p class="contact-body">
      Enquiries about commissions, workshops and available paintings currently go through
      Instagram. A direct enquiry form lands here in the next release.
    </p>
    <a class="contact-button" href="https://www.instagram.com/TARTBYRJ/" target="_blank" rel="noopener noreferrer">
      Message on Instagram
    </a>

    <!-- Formspree form goes here in v2 -->
  </section>
</Layout>

<style>
  .contact {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 160px 24px var(--space-section);
    background: var(--bg-primary);
  }

  .label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin: 0;
  }

  .contact-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(32px, 5.5vw, 60px);
    color: var(--text-primary);
    margin: 16px 0 0;
  }

  .contact-body {
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 52ch;
    margin: 26px 0 34px;
  }

  .contact-button {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    padding: 14px 30px;
    text-decoration: none;
    transition: border-color var(--dur-base) ease;
  }

  .contact-button:hover {
    border-color: var(--accent);
  }
</style>
