---
import Layout from '../../layouts/Layout.astro';
import { client, urlFor } from '../../lib/sanity/client';
import { COLLECTION_BY_SLUG_QUERY } from '../../lib/sanity/queries';
import { CollectionSchema } from '../../types/collection';

export async function getStaticPaths() {
  const slugs: { slug: string }[] = await client.fetch(
    `*[_type == "collection" && defined(slug.current)]{"slug": slug.current}`
  );

  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const raw = await client.fetch(COLLECTION_BY_SLUG_QUERY, { slug });
const parsed = CollectionSchema.safeParse(raw);

if (!parsed.success) {
  return Astro.redirect('/collections');
}

const collection = parsed.data;

const heroUrl = collection.coverImage
  ? urlFor(collection.coverImage).width(1920).format('webp').quality(85).url()
  : undefined;

const storyPageUrls: string[] = (collection.storyPages ?? []).map((page) =>
  urlFor(page).width(1440).format('webp').quality(85).url()
);
---

<Layout title={collection.title}>
  <div class="m-0 bg-black text-white">
    <a
      href="/collections"
      class="fixed top-6 left-6 z-50 text-sm tracking-wide text-white/90 hover:text-white transition-colors [text-shadow:0_1px_4px_rgba(0,0,0,0.6)]"
    >
      ← Back to Collections
    </a>

    <section class="relative h-screen w-full overflow-hidden">
      {heroUrl && (
        <img
          src={heroUrl}
          alt={collection.title}
          class="h-full w-full object-cover"
          loading="eager"
        />
      )}
      <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/70 via-black/10 to-transparent p-10">
        <h1 class="text-4xl md:text-6xl font-light tracking-tight">{collection.title}</h1>
        <p class="mt-2 text-white/80">
          {[collection.location, collection.year].filter(Boolean).join(' · ')}
        </p>
      </div>
    </section>

    {storyPageUrls.length > 0 && (
      <section class="story">
        {storyPageUrls.map((src, i) => (
          <img
            src={src}
            alt={`${collection.title} — page ${i + 1}`}
            class="story-page"
            loading="lazy"
          />
        ))}
      </section>
    )}

    <section class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-2xl md:text-3xl font-light mb-10">Works in this Collection</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {(collection.artworks ?? []).map((artwork: any) => (
          <a href={`/works/${artwork.slug.current}`} class="group block">
            <div class="aspect-square overflow-hidden bg-white/5">
              {artwork.image && (
                <img
                  src={urlFor(artwork.image).width(800).height(800).format('webp').quality(85).url()}
                  alt={artwork.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              )}
            </div>
            <p class="mt-3 text-sm tracking-wide text-white/90">{artwork.title}</p>
            {artwork.year && <p class="text-xs text-white/50">{artwork.year}</p>}
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .story {
    display: flex;
    flex-direction: column;
  }

  .story-page {
    display: block;
    width: 100vw;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: 0;
  }
</style>
