---
import Layout from '../layouts/Layout.astro';
import { client, urlFor } from '../lib/sanity/client';
import { parseList } from '../lib/sanity/parse';
import {
  FEATURED_ARTWORKS_QUERY,
  COLLECTIONS_INDEX_QUERY,
  HOMEPAGE_WORKS_QUERY,
} from '../lib/sanity/queries';
import { ArtworkSchema, type Artwork } from '../types/artwork';
import { CollectionSchema, type Collection } from '../types/collection';

const featuredRaw = await client.fetch(FEATURED_ARTWORKS_QUERY).catch(() => null);
const featuredArtworks = parseList(ArtworkSchema, featuredRaw, 'FEATURED_ARTWORKS_QUERY');

const collectionsRaw = await client.fetch(COLLECTIONS_INDEX_QUERY).catch(() => null);
const collections = parseList(CollectionSchema, collectionsRaw, 'COLLECTIONS_INDEX_QUERY');

const heroImage = featuredArtworks[0]?.image;
const heroUrl = heroImage ? urlFor(heroImage).width(1920).format('webp').url() : undefined;

// Each collection gets exactly one <img>; the browser picks the width from
// srcset rather than the markup shipping a copy per breakpoint.
const COVER_WIDTHS = [480, 800, 1200];
const COVER_SIZES = '(min-width: 1024px) 46vw, (min-width: 640px) 33vw, 100vw';

function coverSrcSet(cover: NonNullable<Collection['coverImage']>): string {
  return COVER_WIDTHS.map(
    (w) => `${urlFor(cover).width(w).format('webp').quality(82).url()} ${w}w`
  ).join(', ');
}

// An image and its row sit in different columns on desktop and interleave below
// 1024px, where they are no longer siblings in the layout tree. Each pair
// therefore carries its own placement values: --gr is the shared grid row on
// tablet, --oi/--or are the flex orders that stack them on mobile.
const rows = collections.map((collection, i) => {
  // location is .nullish() and artworkCount .optional() — build the line from
  // what exists so a missing field never leaves a dangling separator.
  const meta: string[] = [];
  if (collection.year != null) meta.push(String(collection.year));
  if (collection.location) meta.push(collection.location);
  if (typeof collection.artworkCount === 'number' && collection.artworkCount > 0) {
    meta.push(`${collection.artworkCount} ${collection.artworkCount === 1 ? 'work' : 'works'}`);
  }

  return {
    collection,
    meta: meta.join(' · '),
    placement: `--gr:${3 + i};--oi:${3 + i * 2};--or:${4 + i * 2}`,
  };
});

// ─── 02 · RECENT WORKS ───
const recentRaw = await client.fetch(HOMEPAGE_WORKS_QUERY).catch(() => null);
// HOMEPAGE_WORKS_QUERY filters on defined(image.asset), so nothing is dropped
// here in practice. The guard stays because image is typed .nullish() on the
// schema — this is the narrowing that lets workSrcSet/workHeight take a
// non-null image without an assertion.
const recentWorks = parseList(ArtworkSchema, recentRaw, 'HOMEPAGE_WORKS_QUERY').filter(
  (artwork): artwork is Artwork & { image: NonNullable<Artwork['image']> } =>
    artwork.image != null
);

const WORK_WIDTHS = [400, 800, 1200];
const WORK_BASE_W = 800;
// Sanity encodes intrinsic dimensions in the asset _ref
// (image-<id>-<w>x<h>-<ext>), so the real ratio is available without a second
// request. 4/3 is the fallback if the ref ever stops matching — width and
// height must be on the tag either way, since nothing else reserves the box.
const WORK_FALLBACK_RATIO = 4 / 3;

function workSrcSet(image: NonNullable<Artwork['image']>): string {
  return WORK_WIDTHS.map(
    (w) => `${urlFor(image).width(w).format('webp').quality(82).url()} ${w}w`
  ).join(', ');
}

function workHeight(image: NonNullable<Artwork['image']>): number {
  const dims = /-(\d+)x(\d+)-/.exec(image.asset._ref);
  const ratio = dims ? Number(dims[1]) / Number(dims[2]) : WORK_FALLBACK_RATIO;
  return Math.round(WORK_BASE_W / (Number.isFinite(ratio) && ratio > 0 ? ratio : WORK_FALLBACK_RATIO));
}

const LARGE_SIZES = '(min-width: 900px) 55vw, (min-width: 640px) 50vw, 100vw';
// The 50vw arm under-declares the one tablet tile that spans a full row via
// :last-child:nth-child(odd). sizes cannot branch on a CSS state, and raising
// that arm to 100vw would double the fetch for every ordinary 2-up tile to
// serve the orphan case. At the top of the range a 450px declaration still
// selects the 800w candidate for an ~899px slot, so the cost is a fraction of
// a pixel of sharpness on one tile, not a visibly soft image.
const SMALL_SIZES = '(min-width: 900px) 28vw, (min-width: 640px) 50vw, 100vw';

const tiles = recentWorks.map((artwork, i) => ({
  artwork,
  large: i === 0,
  // medium and year are both .nullish() — join what exists so a missing half
  // never ships a dangling separator.
  meta: [artwork.medium, artwork.year].filter((part) => part != null && part !== '').join(' · '),
  sizes: i === 0 ? LARGE_SIZES : SMALL_SIZES,
}));
---

<Layout title="Home">
  <section class="hero-track" id="hero-track">
    <div class="hero">
      <div class="hero-frame">
        {heroUrl ? (
          <img
            class="hero-media"
            src={heroUrl}
            alt={featuredArtworks[0]?.altText ?? featuredArtworks[0]?.title ?? ''}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="hero-media hero-media-fallback"></div>
        )}
        <div class="hero-overlay"></div>
      </div>

      <div class="hero-content">
        <p class="hero-eyebrow">T.Art by RJ · Murals · Paintings · Drawings</p>
        <h1 class="hero-name">
          <span>Rupjyoti</span> <span class="hero-name-accent">Baruah</span>
        </h1>
        <p class="hero-subtitle">Material Memory · Mark Making</p>
      </div>

      {featuredArtworks[0] && (
        <p class="hero-plate">
          {[featuredArtworks[0].title, featuredArtworks[0].medium, featuredArtworks[0].year]
            .filter(Boolean)
            .join(' · ')}
        </p>
      )}

      <div class="hero-scroll">
        <span class="hero-scroll-line"></span>
        <span class="hero-scroll-text">Scroll</span>
      </div>
    </div>
  </section>

  <section id="collections" class="c reveal" data-collections-index>
    <div class:list={['c-grid', collections.length === 0 && 'c-grid-solo']}>
      <div class="c-band">
        <p class="c-eyebrow">
          <span class="c-eyebrow-num">01</span>
          <span class="c-eyebrow-rule"></span>
        </p>
        {/* TODO: placeholder copy from design reference — replace with RJ's line */}
        {/* The <br> is deliberate: the two-line break is stable at every width,
            where letting it wrap on its own breaks unpredictably around 1100-1300px. */}
        <h2 class="c-title">
          Every surface remembers.<br />
          <em>Every mark</em> tells a story.
        </h2>
        {/* TODO: placeholder copy — replace with RJ's line */}
        <p class="c-lede">
          Each collection gathers work made in one place, over one stretch of time — walls,
          rooms and surfaces that carried a story long before the paint arrived.
        </p>
      </div>

      {/* Both CTAs live inside the populated branch, so the empty state needs its
          own — otherwise the homepage offers no route to /collections at all. */}
      {collections.length === 0 && (
        <p class="c-empty">
          <a class="c-empty-link" href="/collections">Browse collections →</a>
        </p>
      )}

      {collections.length > 0 && (
        <>
          <div class="c-well">
            {rows.map(({ collection, placement }, i) => (
              <a
                class="c-shot"
                href={`/collections/${collection.slug.current}`}
                style={placement}
                data-shot={i}
                aria-hidden="true"
                tabindex="-1"
              >
                {/* COLLECTIONS_INDEX_QUERY filters on defined(coverImage.asset),
                    so the fallback is unreachable today. Kept because coverImage
                    is typed nullish — this is the narrowing that lets
                    coverSrcSet take a non-null cover without an assertion. */}
                {collection.coverImage ? (
                  <img
                    src={urlFor(collection.coverImage).width(800).format('webp').quality(82).url()}
                    srcset={coverSrcSet(collection.coverImage)}
                    sizes={COVER_SIZES}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="c-shot-fallback"></span>
                )}
              </a>
            ))}
          </div>

          <div class="c-right">
            <div class="c-head">
              <span class="c-head-label">Collections</span>
              <a class="c-head-link" href="/collections">View all collections</a>
            </div>

            <div class="c-list">
              {rows.map(({ collection, meta, placement }, i) => (
                <a
                  class="c-row"
                  href={`/collections/${collection.slug.current}`}
                  style={placement}
                  data-row={i}
                >
                  <span class="c-row-top">
                    <span class="c-row-title">{collection.title}</span>
                    <span class="c-row-arrow" aria-hidden="true">→</span>
                  </span>
                  {meta && <span class="c-row-meta">{meta}</span>}
                </a>
              ))}
            </div>

            <a class="c-foot-link" href="/collections">View all collections</a>
          </div>
        </>
      )}
    </div>
  </section>

  <section id="works" class="rw reveal">
    <div class="rw-head">
      <h2 class="rw-label">Recent Works</h2>
      <a class="rw-head-link" href="/works">View all works</a>
    </div>

    {/* A failed fetch or a dataset with no usable images would otherwise leave
        the header standing over blank space. Same shape as .c-empty. */}
    {tiles.length === 0 && (
      <p class="rw-empty">
        New works coming soon. <a href="/works">Browse the archive →</a>
      </p>
    )}

    {tiles.length > 0 && (
      <>
        {/* Rows are separate grids so row 1 can keep its uneven columns while
            row 2 stays even. Empty slots are never rendered — a short list
            simply ends. */}
        <div class="rw-row rw-row1">
          {tiles.slice(0, 3).map(({ artwork, large, meta, sizes }) => (
            <a class:list={['rw-tile', large && 'rw-tile-lg']} href={`/works/${artwork.slug.current}`}>
              <span class="rw-shot">
                <img
                  src={urlFor(artwork.image).width(WORK_BASE_W).format('webp').quality(82).url()}
                  srcset={workSrcSet(artwork.image)}
                  sizes={sizes}
                  width={WORK_BASE_W}
                  height={workHeight(artwork.image)}
                  alt={artwork.altText ?? artwork.title}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              {artwork.featured && <span class="rw-badge">Featured</span>}
              <span class:list={['rw-info', artwork.featured && 'rw-info-tight']}>
                <span class="rw-title">{artwork.title}</span>
                {meta && <span class="rw-sub">{meta}</span>}
              </span>
            </a>
          ))}
        </div>

        {tiles.length > 3 && (
          <div class="rw-row rw-row2">
            {tiles.slice(3, 6).map(({ artwork, meta, sizes }) => (
              <a class="rw-tile" href={`/works/${artwork.slug.current}`}>
                <span class="rw-shot">
                  <img
                    src={urlFor(artwork.image).width(WORK_BASE_W).format('webp').quality(82).url()}
                    srcset={workSrcSet(artwork.image)}
                    sizes={sizes}
                    width={WORK_BASE_W}
                    height={workHeight(artwork.image)}
                    alt={artwork.altText ?? artwork.title}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                {artwork.featured && <span class="rw-badge">Featured</span>}
                <span class:list={['rw-info', artwork.featured && 'rw-info-tight']}>
                  <span class="rw-title">{artwork.title}</span>
                  {meta && <span class="rw-sub">{meta}</span>}
                </span>
              </a>
            ))}
          </div>
        )}
      </>
    )}
  </section>

  <section class="about-teaser">
    <p class="label about-label">T.Art by RJ</p>
    <h2 class="about-heading">Artist · Muralist · Storyteller</h2>
    <p class="about-body">
      Through murals, drawing and public art, Rupjyoti Baruah explores the stories carried by
      people, places and living beings.
    </p>
    <a class="collection-link" href="/about">Read more →</a>
  </section>
</Layout>

<script is:inline>
  (function () {
    var track = document.getElementById('hero-track');
    if (!track) return;

    // Reduced motion keeps the static hero: --p stays at its default of 1 and
    // the track keeps its plain 100vh height.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    track.classList.add('is-animated');

    var ticking = false;

    function update() {
      ticking = false;
      var distance = track.offsetHeight - window.innerHeight;
      if (distance <= 0) {
        track.style.setProperty('--p', '1');
        return;
      }
      var progress = -track.getBoundingClientRect().top / distance;
      track.style.setProperty('--p', Math.min(Math.max(progress, 0), 1).toFixed(4));
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    // passive: true — this reads scroll position, it never intercepts or
    // blocks it. Wheel, trackpad, touch, keyboard, scrollbar and in-page
    // anchors all behave exactly as they normally would.
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();
</script>

<script is:inline>
  (function () {
    // Scoped to the section, not a global id — the page could grow a second one.
    var root = document.querySelector('[data-collections-index]');
    if (!root) return;

    var shots = root.querySelectorAll('[data-shot]');
    var rows = root.querySelectorAll('[data-row]');
    if (!shots.length || !rows.length) return;

    // The swap only exists at >=1024px, where the shared image well exists.
    // Below that every image is already inline in its own row.
    var desktop = window.matchMedia('(min-width: 1024px)');
    var handlers = [];

    function activate(index) {
      for (var i = 0; i < shots.length; i++) {
        shots[i].classList.toggle('is-active', i === index);
      }
      for (var j = 0; j < rows.length; j++) {
        rows[j].classList.toggle('is-active', j === index);
      }
    }

    function bind() {
      if (handlers.length) return;
      // .js-on hands opacity control to the script. Without it the CSS keeps
      // the first shot visible on its own, so a failed script leaves a static
      // section rather than an empty well.
      root.classList.add('js-on');
      activate(0);

      for (var i = 0; i < rows.length; i++) {
        (function (index) {
          var row = rows[index];
          var onEnter = function () {
            activate(index);
          };
          // focusin, not focus — keyboard parity with the pointer path.
          row.addEventListener('mouseenter', onEnter);
          row.addEventListener('focusin', onEnter);
          handlers.push([row, onEnter]);
        })(i);
      }
    }

    function unbind() {
      if (!handlers.length) return;
      root.classList.remove('js-on');
      for (var i = 0; i < handlers.length; i++) {
        handlers[i][0].removeEventListener('mouseenter', handlers[i][1]);
        handlers[i][0].removeEventListener('focusin', handlers[i][1]);
      }
      handlers.length = 0;
      activate(-1);
    }

    function sync() {
      if (desktop.matches) bind();
      else unbind();
    }

    sync();
    // The media query fires only when the breakpoint is actually crossed —
    // cheaper and more precise than re-checking on every resize event.
    desktop.addEventListener('change', sync);
  })();
</script>

<style>
  .label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ─── HERO ─── */
  /* ── Scroll-expanding hero ──────────────────────────────
     Everything reads from --p (0 → 1), which the inline script writes from
     real scroll position. It defaults to 1 — the finished, full-bleed state —
     so with no JS, or with reduced motion, the hero renders as a normal
     static hero and nothing is hidden. The script opts in by adding
     .is-animated, which is also what gives the track its scroll length. */
  .hero-track {
    --p: 1;
    --plate-w: 320px;
    --plate-h: 430px;
    position: relative;
    height: 100vh;
  }

  .hero-track.is-animated {
    height: 260vh;
  }

  .hero {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
  }

  .hero-track.is-animated .hero {
    position: sticky;
    top: 0;
  }

  /* The plate: a small framed canvas that opens to full bleed. */
  .hero-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(var(--plate-w) + var(--p) * (100vw - var(--plate-w)));
    height: calc(var(--plate-h) + var(--p) * (100vh - var(--plate-h)));
    transform: translate(-50%, -50%);
    overflow: hidden;
    border: 1px solid transparent;
    box-shadow: 0 40px 90px
      color-mix(in srgb, var(--text-primary) calc((1 - var(--p)) * 20%), transparent);
  }

  .hero-track.is-animated .hero-frame {
    border-color: color-mix(
      in srgb,
      var(--border-strong) calc((1 - var(--p)) * 100%),
      transparent
    );
  }

  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-media-fallback {
    background: var(--hero-fallback);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay);
    opacity: var(--p);
  }

  .hero-content {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 60px 52px;
    max-width: 900px;
  }

  /* Wall label for the featured work — arrives once the plate is fully open,
     taking the corner the scroll prompt has just vacated. */
  .hero-plate {
    position: absolute;
    right: 52px;
    bottom: 60px;
    max-width: 340px;
    text-align: right;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    line-height: 2;
    color: var(--text-secondary);
    margin: 0;
    opacity: calc((var(--p) - 0.72) / 0.28);
  }

  .hero-eyebrow {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-secondary);
    margin: 0 0 18px;
    animation: fade-up 0.9s var(--ease-out) 0.1s both;
  }

  .hero-name {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(46px, 9vw, 108px);
    line-height: 0.98;
    color: var(--text-primary);
    margin: 0;
    animation: fade-up 0.9s var(--ease-out) 0.25s both;
  }

  .hero-name-accent {
    font-style: italic;
    color: var(--accent);
  }

  .hero-subtitle {
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin: 20px 0 0;
    animation: fade-up 0.9s var(--ease-out) 0.4s both;
  }

  .hero-scroll {
    position: absolute;
    right: 52px;
    bottom: 60px;
    display: flex;
    align-items: center;
    gap: 12px;
    animation: fade-up 0.9s var(--ease-out) 0.6s both;
  }

  /* While the plate opens, the load-in animations hand over to --p. Out-of-range
     opacity values clamp to 0/1, so each element gets its own window: the name
     settles in over the back half, the prompt retires once you've taken it. */
  .hero-track.is-animated .hero-eyebrow,
  .hero-track.is-animated .hero-name,
  .hero-track.is-animated .hero-subtitle,
  .hero-track.is-animated .hero-scroll {
    animation: none;
  }

  .hero-track.is-animated .hero-content {
    opacity: calc((var(--p) - 0.5) / 0.35);
    transform: translateY(calc((1 - var(--p)) * 26px));
  }

  .hero-track.is-animated .hero-scroll {
    opacity: calc(1 - var(--p) / 0.45);
  }

  .hero-scroll-line {
    display: block;
    width: 46px;
    height: 1px;
    background: var(--accent);
  }

  .hero-scroll-text {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-secondary);
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── 01 · COLLECTIONS INDEX ─────────────────────────────
     One <img> per collection, moved between layouts rather than duplicated.
     At >=1024px the images are absolutely stacked in a shared well in the left
     column and cross-faded. Below that the well, its column wrapper and the
     list all become display: contents, which drops their boxes and leaves the
     images and rows as siblings of the same grid — so each pair can be placed
     side by side (tablet) or stacked (mobile) without a second set of markup.
     Chrome downloads display:none images anyway, so hiding a duplicate set
     would cost the bytes twice and buy nothing. */
  .c {
    /* Shared so the image well can offset itself against the headline's own
       size — see .c-well's margin-top. */
    --c-title-size: clamp(30px, 3.6vw, 56px);
    /* Eyebrow line box + its 26px margin. Fixed: the eyebrow is 11px at every
       width, so this never has to scale. */
    --c-eyebrow-block: 42.5px;
    /* Distance from the headline's line-box top down to the ink top of a
       capital, as a fraction of font-size. Measured in Chrome against the real
       webfont, not assumed: Cormorant Garamond's capital is 0.625em tall
       against a 0.926em ascent, and line-height 1.12 is tighter than the font's
       natural 1.215, so the half-leading is negative (-2.47px at 51.84px).
       That nets to 0.253em, well past the ~0.09em a normal-leading face would
       give. Confirmed stable: 0.2533em at 1440px, 0.2591em at 1200px. */
    --c-cap-drop: 0.253;
    padding-block: 110px;
    padding-inline: clamp(24px, 4vw, 56px);
    background: var(--bg-primary);
    scroll-margin-top: var(--nav-h);
  }

  .c-grid {
    display: grid;
  }

  .c-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 26px;
  }

  .c-eyebrow-num {
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--accent);
  }

  .c-eyebrow-rule {
    display: block;
    width: 40px;
    height: 1px;
    background: var(--border-strong);
  }

  /* No text-wrap: balance — the line break is set manually in the markup, and
     balancing would fight it for control of the second line.
     No max-width either: the 52% column is the measure. */
  .c-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: var(--c-title-size);
    line-height: 1.12;
    color: var(--text-primary);
    margin: 0;
  }

  .c-title em {
    font-style: italic;
    color: var(--accent);
  }

  .c-lede {
    max-width: 460px;
    margin: 30px 0 0;
    font-size: 15px;
    line-height: 1.85;
    color: var(--text-secondary);
  }

  /* The image is a second route to the same collection — aria-hidden and
     removed from the tab order so it is not a duplicate stop for the row link
     it sits beside, but still tappable where it is the dominant element. */
  .c-shot {
    display: block;
  }

  .c-shot img,
  .c-shot-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .c-shot-fallback {
    background: var(--bg-elevated);
  }

  .c-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 14px;
  }

