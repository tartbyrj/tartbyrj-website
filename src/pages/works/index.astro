---
import Layout from '../../layouts/Layout.astro';
import { client, urlFor } from '../../lib/sanity/client';
import { parseList } from '../../lib/sanity/parse';
import { ALL_ARTWORKS_QUERY } from '../../lib/sanity/queries';
import { ArtworkSchema } from '../../types/artwork';

const raw = await client.fetch(ALL_ARTWORKS_QUERY).catch(() => null);
const artworks = parseList(ArtworkSchema, raw, 'ALL_ARTWORKS_QUERY');

const filters = ['All', 'Acrylic', 'Oil', 'Watercolour', 'Mixed'];
---

<Layout title="Works">
  <header class="page-head">
    <p class="label">Portfolio</p>
    <h1 class="page-title">Works</h1>
  </header>

  {artworks.length > 0 ? (
    <>
      <div class="chips" role="group" aria-label="Filter works by medium">
        {filters.map((filter) => (
          <button class:list={['chip', filter === 'All' && 'active']} data-filter={filter} type="button">
            {filter}
          </button>
        ))}
      </div>

      <div class="works-grid">
        {artworks.map((artwork) => (
          <a
            class="work-card reveal"
            href={`/works/${artwork.slug.current}`}
            data-medium={artwork.medium ?? ''}
          >
            <div class="work-card-media">
              {artwork.image && (
                <img
                  src={urlFor(artwork.image).width(800).format('webp').quality(85).url()}
                  alt={artwork.altText ?? artwork.title}
                  loading="lazy"
                />
              )}
            </div>
            <div class="work-card-overlay">
              <p class="work-card-title">{artwork.title}</p>
              <p class="work-card-meta">
                {[artwork.medium, artwork.year].filter(Boolean).join(' · ')}
              </p>
            </div>
          </a>
        ))}
      </div>
    </>
  ) : (
    <p class="empty">Works coming soon.</p>
  )}
</Layout>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll('.chip');
    var cards = document.querySelectorAll('.work-card');
    if (!chips.length) return;

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var filter = chip.getAttribute('data-filter');

        chips.forEach(function (c) {
          c.classList.remove('active');
        });
        chip.classList.add('active');

        cards.forEach(function (card) {
          var medium = (card.getAttribute('data-medium') || '').toLowerCase();
          var show = filter === 'All' || medium.indexOf(filter.toLowerCase()) !== -1;
          card.style.display = show ? '' : 'none';
        });
      });
    });
  })();
</script>

<style>
  .label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
    margin: 0;
  }

  .page-head {
    padding: 140px 52px 30px;
    background: var(--bg-primary);
  }

  .page-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(38px, 7vw, 76px);
    color: var(--text-primary);
    margin: 12px 0 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0 52px 36px;
    background: var(--bg-primary);
  }

  .chip {
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 9px 18px;
    cursor: pointer;
    transition: color var(--dur-base) ease, border-color var(--dur-base) ease;
  }

  .chip:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
  }

  .chip.active {
    color: var(--accent);
    border-color: var(--accent);
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    padding: 0 52px var(--space-section);
    background: var(--bg-primary);
  }

  .work-card {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--bg-secondary);
    text-decoration: none;
  }

  .work-card-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .work-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .work-card:hover .work-card-media img {
    transform: scale(1.03);
  }

  .work-card-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 18px 20px;
    background: var(--hero-overlay);
    transform: translateY(100%);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .work-card:hover .work-card-overlay,
  .work-card:focus-visible .work-card-overlay {
    transform: translateY(0);
  }

  .work-card-title {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--text-primary);
    margin: 0;
  }

  .work-card-meta {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--text-secondary);
    margin: 5px 0 0;
  }

  .empty {
    padding: 80px 52px var(--space-section);
    text-align: center;
    color: var(--text-secondary);
    background: var(--bg-primary);
  }

  @media (max-width: 1100px) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .page-head {
      padding: 120px 24px 24px;
    }

    .chips {
      padding: 0 24px 28px;
    }

    .works-grid {
      grid-template-columns: 1fr;
      padding: 0 24px var(--space-section-m);
    }
  }
</style>
