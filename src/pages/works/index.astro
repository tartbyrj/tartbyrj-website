---
import WorksGallery from '../../components/works/WorksGallery.astro';
import Layout from '../../layouts/Layout.astro';
import { getAllArtworks } from '../../lib/works/data';
import { EMPTY_FILTER } from '../../lib/works/filters';

// The unfiltered view: everything, including work with no taxonomy tags, which
// appears here and on no filter route. Filter routes live in [...filter].astro
// and are generated from the tags — see src/lib/works/filters.ts.
//
// getAllArtworks() is memoized per build, so this and [...filter].astro's
// getStaticPaths share one Sanity fetch in production instead of racing two
// independent ones (memoization is skipped in dev, on purpose — see
// src/lib/works/data.ts).
const artworks = await getAllArtworks();
---

<Layout
  title="Works"
  description="Original paintings by Rupjyoti Baruah, grouped by year — acrylic, oil, watercolour, mixed media, charcoal and ink."
>
  <WorksGallery artworks={artworks} allArtworks={artworks} filter={EMPTY_FILTER} />
</Layout>
