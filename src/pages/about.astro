---
import { z } from 'zod';
import Layout from '../layouts/Layout.astro';
import { client, urlFor } from '../lib/sanity/client';
import { ABOUT_QUERY } from '../lib/sanity/queries';

const AboutSchema = z.object({
  biography: z.unknown().optional(),
  statement: z.string().optional(),
  portrait: z.object({ asset: z.object({ _ref: z.string() }) }).optional(),
});

const raw = await client.fetch(ABOUT_QUERY).catch(() => null);
const result = AboutSchema.safeParse(raw);
const about = result.success ? result.data : undefined;

const FALLBACK_BIO =
  'Through murals, drawing and public art, Rupjyoti Baruah explores the stories carried by people, places and living beings.';
const FALLBACK_STATEMENT = 'Observation. Memory. Connection.';

// `biography` is Portable Text. Flatten each block's spans into a paragraph;
// fall back to the default copy when Sanity has nothing to render.
function toParagraphs(value: unknown): string[] {
  if (!Array.isArray(value)) return [FALLBACK_BIO];

  const paragraphs = value
    .map((block) => {
      if (typeof block !== 'object' || block === null) return '';
      const children = (block as { children?: unknown }).children;
      if (!Array.isArray(children)) return '';
      return children
        .map((child) =>
          typeof child === 'object' && child !== null && typeof (child as { text?: unknown }).text === 'string'
            ? (child as { text: string }).text
            : ''
        )
        .join('');
    })
    .filter((text) => text.trim().length > 0);

  return paragraphs.length > 0 ? paragraphs : [FALLBACK_BIO];
}

const paragraphs = toParagraphs(about?.biography);
const statement = about?.statement ?? FALLBACK_STATEMENT;
const portraitUrl = about?.portrait
  ? urlFor(about.portrait).width(900).format('webp').quality(85).url()
  : undefined;

const availableFor = ['Private commissions', 'Painting workshops', 'Studio visits'];
---

<Layout title="About">
  <div class="about">
    <div class="about-media">
      {portraitUrl ? (
        <img src={portraitUrl} alt="Rupjyoti Baruah" loading="eager" />
      ) : (
        <div class="about-media-fallback"></div>
      )}
      <p class="about-caption">
        Rupjyoti Baruah — Artist · Muralist · Storyteller · Dubai · Assam, India
      </p>
    </div>

    <div class="about-body">
      <p class="label">The Artist</p>

      <h1 class="about-heading">
        <span>Rupjyoti</span> <span class="about-heading-accent">Baruah</span>
      </h1>

      {paragraphs.map((text) => <p class="about-para">{text}</p>)}

      <blockquote class="about-quote">{statement}</blockquote>

      <section class="about-block">
        <p class="label">Available for</p>
        <ul class="about-list">
          {availableFor.map((item) => (
            <li>— {item}</li>
          ))}
        </ul>
      </section>

      <section class="about-block">
        <p class="label">Exhibitions</p>
        <ul class="exhibitions">
          {[0, 1, 2].map(() => (
            <li class="exhibition">
              <span class="exhibition-year">—</span>
              <span class="exhibition-name">—</span>
              <span class="exhibition-venue">—</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Layout>

<style>
  .label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
    margin: 0;
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 60px;
    padding: 140px 52px var(--space-section);
    background: var(--bg-primary);
    align-items: start;
  }

  .about-media {
    position: sticky;
    top: 100px;
  }

  .about-media img,
  .about-media-fallback {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  .about-media-fallback {
    background: var(--bg-secondary);
  }

  .about-caption {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 14px 0 0;
    line-height: 1.6;
  }

  .about-heading {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(34px, 5.5vw, 64px);
    line-height: 1.02;
    color: var(--text-primary);
    margin: 14px 0 30px;
  }

  .about-heading-accent {
    font-style: italic;
    color: var(--accent);
  }

  .about-para {
    color: var(--text-secondary);
    line-height: 1.8;
    margin: 0 0 18px;
    max-width: 58ch;
  }

  .about-quote {
    border-left: 1px solid var(--accent-dim);
    padding-left: 22px;
    margin: 34px 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    color: var(--text-primary);
  }

  .about-block {
    margin-top: 44px;
  }

  .about-list {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }

  .about-list li {
    color: var(--text-secondary);
    line-height: 2;
  }

  .exhibitions {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }

  .exhibition {
    display: grid;
    grid-template-columns: 70px 1fr 1fr;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 120px 24px var(--space-section-m);
    }

    .about-media {
      position: static;
    }

    .exhibition {
      grid-template-columns: 56px 1fr;
    }

    .exhibition-venue {
      grid-column: 2;
    }
  }
</style>
